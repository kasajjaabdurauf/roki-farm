# ------------------------------------------------------------------
# Roki Fruit & Vegetables — environment variables
#
# DEMO MODE (default): leave Supabase vars empty → app runs fully
# offline-first in the browser with the persona switcher.
#
# PRODUCTION MODE: fill in the Supabase values → app requires login
# (Supabase Auth) and syncs the local store to the cloud database.
# ------------------------------------------------------------------

# --- Supabase (production mode) -------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Backend automation (GitHub secrets — NOT for the browser) ------
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # daily backup script
# RESEND_API_KEY=re_xxxxxxxx                          # daily backup email
# BACKUP_EMAIL_TO=joan@farm.com                       # backup recipient
# BACKUP_EMAIL_FROM=onboarding@resend.dev             # verified sender

# --- Sentry (optional error monitoring) -------------------------------
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
